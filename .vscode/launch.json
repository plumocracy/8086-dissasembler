{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(lldb) Launch decoder",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/a.out",
            "args": ["${workspaceFolder}/sr"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "lldb",
            "preLaunchTask": "build decoder (debug)"
        },
        {
            "name": "(lldb) Attach",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/a.out",
            "MIMode": "lldb"
        }
    ]
}
