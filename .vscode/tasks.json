{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build decoder (debug)",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-g",
                "-O0",
                "-std=c++17",
                "${workspaceFolder}/decoder.cpp",
                "-o",
                "${workspaceFolder}/a.out"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
